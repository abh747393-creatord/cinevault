# ==============================================================================
# CineVault Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust / Axum Streaming Backend (Render)
# ------------------------------------------------------------------------------
# In Development: Defaults to http://localhost:8080 if not set.
# In Production (Vercel): Set to your deployed Render URL (without trailing slash).
NEXT_PUBLIC_RUST_API_URL=https://cinevault-api.onrender.com

# Legacy alias (also supported as fallback):
# NEXT_PUBLIC_MOVIEBOX_API_URL=https://cinevault-api.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 2. Supabase Database & Authentication
# ------------------------------------------------------------------------------
# Public Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://msoenbqurypcednvwsgz.supabase.co

# Public Supabase Anon (Publishable) Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Private Supabase Service Role Key (Server-side API routes only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Next.js Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
